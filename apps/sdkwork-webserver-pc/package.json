{
  "name": "@sdkwork/webserver-pc",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "predev": "node scripts/materialize-runtime-env.mjs --environment development",
    "dev": "vite --host 127.0.0.1",
    "prebuild": "node scripts/materialize-runtime-env.mjs --environment production",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "verify": "pnpm check",
    "preview": "vite preview --host 127.0.0.1",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@sdkwork/auth-pc-react": "workspace:*",
    "@sdkwork/auth-runtime-pc-react": "workspace:*",
    "@sdkwork/iam-app-sdk": "workspace:*",
    "@sdkwork/sdk-common": "workspace:*",
    "@sdkwork/web-app-sdk": "workspace:*",
    "@sdkwork/web-backend-sdk": "workspace:*",
    "@sdkwork/webserver-pc-admin-audit": "workspace:*",
    "@sdkwork/webserver-pc-admin-core": "workspace:*",
    "@sdkwork/webserver-pc-admin-diagnostics": "workspace:*",
    "@sdkwork/webserver-pc-admin-nginx": "workspace:*",
    "@sdkwork/webserver-pc-admin-servers": "workspace:*",
    "@sdkwork/webserver-pc-admin-shell": "workspace:*",
    "@sdkwork/webserver-pc-commons": "workspace:*",
    "@sdkwork/webserver-pc-console-core": "workspace:*",
    "@sdkwork/webserver-pc-console-delivery": "workspace:*",
    "@sdkwork/webserver-pc-console-deployments": "workspace:*",
    "@sdkwork/webserver-pc-console-shell": "workspace:*",
    "@sdkwork/webserver-pc-console-site-configuration": "workspace:*",
    "@sdkwork/webserver-pc-console-sites": "workspace:*",
    "@sdkwork/webserver-pc-core": "workspace:*",
    "lucide-react": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-router-dom": "^7.15.0"
  },
  "devDependencies": {
    "@testing-library/react": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "jsdom": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}

