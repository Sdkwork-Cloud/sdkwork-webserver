{
  "name": "@sdkwork/webserver-pc",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "pnpm dev:standalone",
    "dev:standalone": "pnpm exec sdkwork-app dev --root ../.. --deployment-profile standalone",
    "dev:cloud": "pnpm exec sdkwork-app dev --root ../.. --deployment-profile cloud",
    "dev:browser": "pnpm dev:browser:postgres:standalone",
    "dev:browser:postgres:standalone": "pnpm exec sdkwork-app dev --root ../.. --runtime-target browser --deployment-profile standalone",
    "dev:browser:cloud": "pnpm exec sdkwork-app dev --root ../.. --runtime-target browser --deployment-profile cloud",
    "stop": "pnpm exec sdkwork-app stop --root ../..",
    "prebuild": "node scripts/verify-build-sources.mjs && node scripts/materialize-runtime-env.mjs --deployment-profile cloud --environment production",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "check:source-config": "node ../../../sdkwork-specs/tools/check-source-config-standard.mjs --root .",
    "check:pnpm-script-standard": "node ../../../sdkwork-specs/tools/check-pnpm-script-standard.mjs --root . --product-prefix webserver",
    "check": "pnpm typecheck && pnpm test && pnpm build && pnpm check:source-config && pnpm check:pnpm-script-standard",
    "verify": "pnpm check",
    "preview": "vite preview --host 127.0.0.1",
    "start": "pnpm preview",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "_sdkwork:dev:standalone": "node scripts/verify-build-sources.mjs && node scripts/materialize-runtime-env.mjs --deployment-profile standalone --environment development && vite --host 127.0.0.1 --port 5182 --strictPort",
    "_sdkwork:dev:cloud": "node scripts/verify-build-sources.mjs && node scripts/materialize-runtime-env.mjs --deployment-profile cloud --environment development && vite --host 127.0.0.1 --port 5182 --strictPort"
  },
  "dependencies": {
    "@sdkwork/auth-pc-react": "workspace:*",
    "@sdkwork/auth-runtime-pc-react": "workspace:*",
    "@sdkwork/iam-app-sdk": "workspace:*",
    "@sdkwork/iam-contracts": "workspace:*",
    "@sdkwork/iam-credential-entry": "workspace:*",
    "@sdkwork/iam-runtime": "workspace:*",
    "@sdkwork/i18n-pc-react": "workspace:*",
    "@sdkwork/sdk-common": "workspace:*",
    "@sdkwork/ui-pc-react": "workspace:*",
    "@sdkwork/web-app-sdk": "workspace:*",
    "@sdkwork/web-backend-sdk": "workspace:*",
    "@sdkwork/webserver-pc-admin-audit": "workspace:*",
    "@sdkwork/webserver-pc-admin-applications": "workspace:*",
    "@sdkwork/webserver-pc-admin-certificates": "workspace:*",
    "@sdkwork/webserver-pc-admin-core": "workspace:*",
    "@sdkwork/webserver-pc-admin-diagnostics": "workspace:*",
    "@sdkwork/webserver-pc-admin-nginx": "workspace:*",
    "@sdkwork/webserver-pc-admin-servers": "workspace:*",
    "@sdkwork/webserver-pc-admin-shell": "workspace:*",
    "@sdkwork/webserver-pc-commons": "workspace:*",
    "@sdkwork/webserver-pc-console-core": "workspace:*",
    "@sdkwork/webserver-pc-console-delivery": "workspace:*",
    "@sdkwork/webserver-pc-console-deployments": "workspace:*",
    "@sdkwork/webserver-pc-console-shell": "workspace:*",
    "@sdkwork/webserver-pc-console-site-configuration": "workspace:*",
    "@sdkwork/webserver-pc-console-sites": "workspace:*",
    "@sdkwork/webserver-pc-core": "workspace:*",
    "@tailwindcss/typography": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "lucide-react": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-router-dom": "^7.15.0",
    "tailwindcss": "catalog:"
  },
  "devDependencies": {
    "@testing-library/react": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "jsdom": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
