# Durable certificate operation worker (copy to .env on control plane host)

# Unique stable lease owner for this worker instance
SDKWORK_WEB_CERT_WORKER_ID=certificate-worker-dev-1

# Pending/retry operation polling interval in seconds (default 5)
SDKWORK_WEB_CERT_OPERATION_POLL_INTERVAL_SECS=5

# Due-renewal scheduling interval in seconds (default 3600 = 1 hour)
SDKWORK_WEB_CERT_RENEW_SCAN_INTERVAL_SECS=3600

# Days before not_after to trigger renewal (default 30)
SDKWORK_WEB_CERT_RENEW_BEFORE_DAYS=30

# Shared with the application runtime and ACME service
SDKWORK_WEB_ACME_DIRECTORY_URL=https://acme-staging-v02.api.letsencrypt.org/directory
SDKWORK_WEB_ACME_PROFILE=staging
SDKWORK_WEB_ACME_CONTACT_EMAIL=admin@localhost
SDKWORK_WEB_ACME_WEBROOT=/var/www/acme-challenge
SDKWORK_WEB_ACME_OPERATION_TIMEOUT_MS=180000
# Encrypted ACME account credentials directory; required in production-like
# environments so renewals reuse one CA account across restarts.
SDKWORK_WEB_ACME_ACCOUNT_ROOT=/var/lib/sdkwork/web/certs/accounts
SDKWORK_WEB_CERT_LIVE_ROOT=/opt/certs/letsencrypt/live
SDKWORK_WEB_NGINX_SITES_ROOT=/etc/nginx/sites-enabled/sdkwork

# Self-hosted TLS runtime distribution: after each successful certificate
# operation the worker projects the node's listener certificate bindings into
# the TLS material root and snapshot file consumed by the data plane.
SDKWORK_WEB_NODE_UUID=
SDKWORK_WEB_TLS_MATERIAL_ROOT=/var/lib/sdkwork/web/tls-materials
SDKWORK_WEB_TLS_RUNTIME_SNAPSHOT_FILE=/var/lib/sdkwork/web/tls-materials/tls-runtime.json
SDKWORK_WEB_TLS_SNAPSHOT_ALPN=h2,http/1.1
