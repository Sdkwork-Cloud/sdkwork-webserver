# standalone.development
SDKWORK_DEPLOYMENT_PROFILE=standalone
SDKWORK_ENVIRONMENT=development
SDKWORK_CORS_ALLOWED_ORIGINS=http://127.0.0.1:5182
SDKWORK_PROFILE_ID=standalone.development
SDKWORK_WEB_DEPLOYMENT_PROFILE=standalone
SDKWORK_WEB_ENVIRONMENT=development
SDKWORK_WEB_PROFILE_ID=standalone.development
SDKWORK_WEB_SNOWFLAKE_NODE_ID=0
SDKWORK_WEB_PC_DEV_BIND=127.0.0.1:5182
SDKWORK_WEB_APPLICATION_PUBLIC_INGRESS_BIND=127.0.0.1:3800
SDKWORK_WEB_APPLICATION_PUBLIC_HTTP_URL=http://127.0.0.1:3800
SDKWORK_WEB_APPLICATION_APP_HTTP_URL=http://127.0.0.1:3800
SDKWORK_WEB_APPLICATION_BACKEND_HTTP_URL=http://127.0.0.1:3800
SDKWORK_IAM_APP_ROOT=../sdkwork-iam
SDKWORK_DRIVE_APP_ROOT=../sdkwork-drive
# SDKWork Deployments same-origin dependency assembly (API_ASSEMBLY_SPEC §6.1):
# the Deployments service host and domain/certificate blocks run inside this
# gateway process; cloud profiles keep the external deploy-app URL instead.
SDKWORK_DEPLOY_DEPLOYMENT_PROFILE=standalone
SDKWORK_DEPLOY_ENVIRONMENT=development
SDKWORK_DEPLOY_PROFILE_ID=standalone.development
SDKWORK_DEPLOY_USE_MEMORY_DRIVE=1
SDKWORK_DEPLOY_USE_MEMORY_CONTENT_PROVIDER=true

# ACME / certificate lifecycle (worker + self-hosted TLS runtime distribution)
SDKWORK_WEB_ACME_PROFILE=staging
SDKWORK_WEB_ACME_DIRECTORY_URL=https://acme-staging-v02.api.letsencrypt.org/directory
SDKWORK_WEB_ACME_CONTACT_EMAIL=admin@localhost
SDKWORK_WEB_ACME_WEBROOT=./target/acme-webroot
SDKWORK_WEB_ACME_ACCOUNT_ROOT=./target/certs/accounts
SDKWORK_WEB_CERT_RENEW_BEFORE_DAYS=30
SDKWORK_WEB_CERT_WORKER_ID=certificate-worker-dev-1
SDKWORK_WEB_CERT_OPERATION_POLL_INTERVAL_SECS=5
SDKWORK_WEB_CERT_RENEW_SCAN_INTERVAL_SECS=3600
SDKWORK_WEB_NODE_UUID=development-node
SDKWORK_WEB_TLS_MATERIAL_ROOT=./target/tls-materials
SDKWORK_WEB_TLS_RUNTIME_SNAPSHOT_FILE=./target/tls-materials/tls-runtime.json
SDKWORK_WEB_TLS_SNAPSHOT_ALPN=h2,http/1.1
