# standalone.production
SDKWORK_DEPLOYMENT_PROFILE=standalone
SDKWORK_ENVIRONMENT=production
SDKWORK_CORS_ALLOWED_ORIGINS=http://127.0.0.1:3800
SDKWORK_PROFILE_ID=standalone.production
SDKWORK_WEB_DEPLOYMENT_PROFILE=standalone
SDKWORK_WEB_ENVIRONMENT=production
SDKWORK_WEB_PROFILE_ID=standalone.production
SDKWORK_WEB_SNOWFLAKE_NODE_ID=0
SDKWORK_WEB_APPLICATION_PUBLIC_INGRESS_BIND=0.0.0.0:3800
# The management listener carries unauthenticated /healthz /readyz /livez
# and /metrics; a non-loopback bind is explicit operator authorization
# (fail-closed by default, see gateway main.rs).
SDKWORK_WEB_MANAGEMENT_EXPOSE_ALLOWED=true
# Loopback-only data-plane operations listener (metrics/probes); explicit
# bind keeps the standalone profile observable like the cloud profile.
SDKWORK_WEB_DATA_PLANE_OPERATIONS_BIND=127.0.0.1:3901
SDKWORK_WEB_APPLICATION_PUBLIC_HTTP_URL=http://127.0.0.1:3800
SDKWORK_WEB_APPLICATION_APP_HTTP_URL=http://127.0.0.1:3800
SDKWORK_WEB_APPLICATION_BACKEND_HTTP_URL=http://127.0.0.1:3800
SDKWORK_APP_ROOT=.
SDKWORK_WEB_APP_ROOT=.
SDKWORK_WEB_SERVER_APP_ROOT=.
SDKWORK_IAM_APP_ROOT=share/sdkwork/iam
SDKWORK_DRIVE_APP_ROOT=share/sdkwork/drive
SDKWORK_WEB_PC_STATIC_ROOT=share/sdkwork/webserver-pc
# SDKWork Deployments same-origin dependency assembly (API_ASSEMBLY_SPEC §6.1)
SDKWORK_DEPLOY_DEPLOYMENT_PROFILE=standalone
SDKWORK_DEPLOY_ENVIRONMENT=production
SDKWORK_DEPLOY_PROFILE_ID=standalone.production
SDKWORK_DEPLOY_USE_MEMORY_DRIVE=1
SDKWORK_DEPLOY_USE_MEMORY_CONTENT_PROVIDER=true


# Region deployment dimension (REGION_SPEC.md): orthogonal to deployment profile and environment.
SDKWORK_WEBSERVER_REGION_CODE=cn
SDKWORK_DATABASE_SEED_LOCALE=zh-CN

# ACME / certificate lifecycle (worker + self-hosted TLS runtime distribution)
SDKWORK_WEB_ACME_PROFILE=production
SDKWORK_WEB_ACME_DIRECTORY_URL=https://acme-v02.api.letsencrypt.org/directory
SDKWORK_WEB_ACME_CONTACT_EMAIL=admin@localhost
SDKWORK_WEB_ACME_WEBROOT=/var/lib/sdkwork/web/acme-webroot
SDKWORK_WEB_ACME_ACCOUNT_ROOT=/var/lib/sdkwork/web/acme-accounts
SDKWORK_WEB_CERT_RENEW_BEFORE_DAYS=30
SDKWORK_WEB_CERT_WORKER_ID=certificate-worker-0
SDKWORK_WEB_CERT_OPERATION_POLL_INTERVAL_SECS=5
SDKWORK_WEB_CERT_RENEW_SCAN_INTERVAL_SECS=3600
SDKWORK_WEB_NODE_UUID=standalone-node
SDKWORK_WEB_TLS_MATERIAL_ROOT=/var/lib/sdkwork/web/tls-materials
SDKWORK_WEB_TLS_RUNTIME_SNAPSHOT_FILE=/var/lib/sdkwork/web/tls-materials/tls-runtime.json
SDKWORK_WEB_TLS_SNAPSHOT_ALPN=h2,http/1.1
